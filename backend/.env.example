NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/recoverx?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/recoverx?schema=public
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
COOKIE_SECURE=false
# Optional. Leave unset to store development uploads in backend/uploads.
# For Google Drive, set the complete service-account JSON as a single-line value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional Drive folder ID. Share the private folder with the service account.
GOOGLE_DRIVE_FOLDER_ID=
